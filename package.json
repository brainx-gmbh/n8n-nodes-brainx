{
	"name": "n8n-nodes-brainx",
	"version": "0.2.0",
	"description": "n8n community node for brainX systems",
	"license": "MIT",
	"homepage": "https://www.brainx.app/",
	"keywords": [
		"n8n-community-node-package",
		"brainX",
		"CRM"
	],
	"author": {
		"name": "Joris Karl Dzaack",
		"email": "joris.dzaack@brainformatik.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/<...>/n8n-nodes-<...>.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"dev:docker": "bash scripts/docker-test.sh",
		"dev:docker:watch": "bash scripts/docker-dev.sh",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BrainXApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BrainX/BrainX.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.28.0",
		"eslint": "9.32.0",
		"prettier": "^3.8.3",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
